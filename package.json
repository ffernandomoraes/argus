{
  "name": "argus-monorepo",
  "private": true,
  "description": "Canvas infinito para orquestrar projetos e agentes do Claude Code",
  "scripts": {
    "dev": "pnpm --filter argus dev",
    "build": "pnpm --filter argus build",
    "dist": "pnpm --filter argus dist",
    "dist:win": "pnpm --filter argus dist:win",
    "dist:linux": "pnpm --filter argus dist:linux",
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "mobile:dev": "pnpm --filter @argus/mobile dev",
    "mobile:build": "pnpm --filter @argus/mobile build"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true
  },
  "author": "Fernando Moraes <fermoraeslima10@gmail.com>",
  "homepage": "https://github.com/ffernandomoraes/argus",
  "license": "SEE LICENSE IN LICENSE",
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@stylistic/eslint-plugin": "5.10.0",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2"
  }
}
