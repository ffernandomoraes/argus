{
  "name": "argus",
  "productName": "Argus",
  "version": "0.1.15",
  "private": true,
  "description": "Canvas infinito para orquestrar projetos e agentes do Claude Code",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev --watch",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "postinstall": "node scripts/postinstall.mjs",
    "dist": "electron-vite build && electron-builder --mac --arm64",
    "dist:win": "electron-vite build && electron-builder --win --x64"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.292",
    "node-pty": "1.1.0",
    "ws": "^8.22.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.12.4",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "^8.18.2",
    "@uiw/codemirror-theme-vscode": "^4.25.12",
    "@vitejs/plugin-react": "5.2.0",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "@xyflow/react": "12.12.0",
    "codemirror": "^6.0.2",
    "electron": "44.5.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "5.0.0",
    "lucide-react": "1.52.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "7.3.7"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true
  },
  "author": "Fernando Moraes <fermoraeslima10@gmail.com>",
  "homepage": "https://github.com/ffernandomoraes/argus"
}
