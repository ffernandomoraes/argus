{
  "name": "argus",
  "productName": "Argus",
  "version": "0.1.100",
  "private": true,
  "description": "Canvas infinito para orquestrar projetos e agentes do Claude Code",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev --watch",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "postinstall": "node scripts/postinstall.mjs",
    "dist": "electron-vite build && electron-builder --mac --arm64",
    "dist:win": "electron-vite build && electron-builder --win --x64",
    "dist:linux": "electron-vite build && electron-builder --linux --x64",
    "test": "vitest run"
  },
  "dependencies": {
    "@sentry/electron": "8.3.0",
    "@sentry/node-native": "11.8.0",
    "@tanstack/react-virtual": "3.14.22",
    "@xterm/addon-webgl": "0.19.0",
    "@xterm/headless": "6.0.0",
    "node-pty": "1.1.0",
    "onnxruntime-common": "1.30.0",
    "onnxruntime-node": "1.30.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.308",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@huggingface/transformers": "4.3.1",
    "@sentry/bundler-plugins": "11.8.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.19.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "^8.18.2",
    "@uiw/codemirror-theme-vscode": "^4.25.12",
    "@vitejs/plugin-react": "5.2.0",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "@xyflow/react": "12.12.0",
    "codemirror": "^6.0.2",
    "electron": "44.9.3",
    "electron-builder": "^26.15.3",
    "electron-vite": "5.0.0",
    "lucide-react": "1.61.0",
    "qrcode": "^1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "7.3.7",
    "vitest": "5.0.5",
    "zod": "^4.6.7"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true
  },
  "author": "Fernando Moraes <fermoraeslima10@gmail.com>",
  "homepage": "https://github.com/ffernandomoraes/argus",
  "license": "SEE LICENSE IN LICENSE"
}
